# ============================================================
# Bilibili Video Summarizer Bot - Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Bilibili Auth ---
# Login to Bilibili in browser, F12 -> Application -> Cookies
BILIBILI_SESSDATA=your_sessdata_here
BILIBILI_BILI_JCT=your_bili_jct_here
BILIBILI_DEDEUSERID=your_dedeuserid_here

# --- Default LLM (OpenAI-compatible API) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-5.5

# --- Gemini (optional, fallback) ---
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Bot Config ---
# Display name in comment replies
BOT_NAME=Milky
# Your Bilibili UID (for detecting @mentions)
BOT_UID=
# Polling interval in seconds
POLL_INTERVAL=30
# Max characters per comment reply
MAX_REPLY_LENGTH=800
# Expose observability endpoints. On Railway, PORT is preferred automatically.
METRICS_ENABLED=true
METRICS_PORT=9108

# --- Speech-to-Text (optional, auto-transcribe when no CC subtitles) ---
# Default: OpenAI Speech-to-Text API
STT_ENABLED=true
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=gpt-4o-transcribe

# --- Telegram (optional, push summaries/notes via Telegram bot) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Email Notes via AWS SES Email ---
EMAIL_ENABLED=true
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_SENDER=noreply@yourdomain.com
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
